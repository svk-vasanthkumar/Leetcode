class Solution {
    public char findTheDifference(String s, String t) {

        char answer = ' ';

        for(int i=0; i< t.length(); i++){
            boolean found = false;

            for (int j = 0; j < s.length();j++){
                if(t.charAt(i)==s.charAt(j)){
                    found = true;
                    break;
                }
            }
            if(found == false) {
                answer = t.charAt(i);
                 break;
                 }
        }
        return answer;
    }
}
