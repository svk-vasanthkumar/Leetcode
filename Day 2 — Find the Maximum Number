class Solution {
    public int mostWordsFound(String[] sentences) {

        int m = 0;
        
        for(int i=0; i< sentences.length; i++){
            String[] word = sentences[i].split(" ");
            int co = word.length;

           if(co>m)
           {  
            m=co;
           } 
        }
        return m;
        
    }
}
