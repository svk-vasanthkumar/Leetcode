class Solution {
    public int pivotIndex(int[] nums) {

        int totsum =0;
        int LeftSum = 0;
      

        for(int i =0; i< nums.length; i++){
            totsum += nums[i];

        }

        for(int i = 0; i< nums.length; i++){

            int rightSum = totsum - LeftSum - nums[i];

            if(rightSum == LeftSum){
                return i;
            }
             LeftSum += nums[i];
        }

          
        

        return -1;
        
    }
}
