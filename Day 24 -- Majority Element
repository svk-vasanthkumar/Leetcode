class Solution {
    public int majorityElement(int[] nums) {

          int cout =0;
          int candidate = nums[0];

        for (int i = 0; i< nums.length; i++){

            if(cout == 0) {
                candidate = nums[i];
            }


             if (nums[i] == candidate) {
                cout++;
            } else {
                cout--;
            }
        }

        return candidate;
    }
}
